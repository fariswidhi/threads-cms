# Threads CMS v2 — object storage (S3-compatible) credential
# Copy ke .env dan isi. JANGAN commit secret asli.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=<nama-bucket>
R2_CDN_URL=https://<cdn-domain-kamu>
R2_PREFIX=<prefix>

# AI generate (LLM OpenAI-compatible)
AI_BASE_URL=http://localhost:PORT/v1
AI_API_KEY=
AI_MODEL=<model>

# Threads OAuth
# Production (lewat Nginx + HTTPS). Daftarkan THREADS_REDIRECT_URI persis sama di
# Meta Developer > Threads API > Redirect Callback URLs.
APP_BASE_URL=https://cms.larismedia.id
THREADS_REDIRECT_URI=https://cms.larismedia.id/callback
THREADS_APP_ID=1888584452332615
THREADS_APP_SECRET=
# Dev lokal: kosongkan APP_BASE_URL & THREADS_REDIRECT_URI -> callback
# https://localhost:8456/callback (butuh tls-cert.pem & tls-key.pem).
# app_id/app_secret juga boleh tetap di ~/.threads-bot/app.json (env menang).
